{
  "name": "rock-in-pictures",
  "version": "1.0.2",
  "private": true,
  "description": "听见画面：60幅摄影意象，猜60支华语摇滚及独立乐队",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 4319",
    "check": "node --check dist/app.js && node scripts/check-worker.mjs && python3 validate.py",
    "deploy:check": "wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "build:downloads": "python3 scripts/build-downloads.py"
  },
  "devDependencies": {
    "qrcode": "1.5.4",
    "wrangler": "4.151.1"
  }
}
