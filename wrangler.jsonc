{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rock-in-pictures",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "xiaosang.cc/rock-in-pictures",
      "zone_name": "xiaosang.cc"
    },
    {
      "pattern": "xiaosang.cc/rock-in-pictures/*",
      "zone_name": "xiaosang.cc"
    }
  ],
  "main": "worker.mjs"
}
